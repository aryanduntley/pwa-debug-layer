# .watchdogignore — paths the AIMFP watchdog should NOT track.
#
# Gitignore-style syntax (note: negation '!' is NOT supported):
#   tests/                    a directory named 'tests' at any depth
#   packages/host/extension/  an exact nested subtree (relative to project root)
#   *_test.py                 glob matched against the file name
#
# Patterns containing '/' are anchored to the project root (and everything
# beneath them). Patterns without '/' float — they match a file name or any
# single directory component anywhere in the tree.
#
# Built-in exclusions (node_modules, build/dist, .git, .aimfp-project, …) are
# already handled — only project-specific noise is listed here.

# Bundled extension build output copied into the host package (gitignored,
# regenerated by rollup) — not source, should never be tracked.
packages/host/extension/

# Vitest test files + test directories (not tracked source).
test/
*.test.ts
*.test.js

# npm-publish artifacts for the host package (the published @aryanduntley/pwa-debug
# tarball): the build-script dir and the README copied from the repo-root README by
# scripts/copy-readme.mjs during prepack. Tooling + generated copy, not source.
packages/host/scripts/
packages/host/README.md
