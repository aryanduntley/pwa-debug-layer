{
  "name": "@aryanduntley/pwa-debug",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "AI-native MCP debug layer for PWAs: inspect live service workers, CacheStorage, IndexedDB, web storage, installability, and React/Vue/Svelte/Solid + Redux/Zustand/Pinia/Jotai state in your REAL logged-in browser profile. Answers 'why won't my service worker update', 'why is my cache stale', 'why won't my PWA install', 'why are chunks 404ing after deploy'. Complements chrome-devtools-mcp.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "claude",
    "ai-debugging",
    "pwa",
    "progressive-web-app",
    "pwa-diagnostics",
    "service-worker",
    "service-worker-debugging",
    "cache-storage",
    "indexeddb",
    "installability",
    "chrome-extension",
    "chrome-devtools",
    "devtools",
    "browser-automation",
    "react-devtools",
    "redux",
    "vue",
    "svelte",
    "rrweb"
  ],
  "mcpName": "io.github.aryanduntley/pwa-debug-layer",
  "homepage": "https://github.com/aryanduntley/pwa-debug-layer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryanduntley/pwa-debug-layer.git",
    "directory": "packages/host"
  },
  "bugs": {
    "url": "https://github.com/aryanduntley/pwa-debug-layer/issues"
  },
  "author": "aryanduntley",
  "bin": {
    "pwa-debug-host": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "files": [
    "dist",
    "extension"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rollup -c && chmod +x dist/main.js && node ./scripts/bundle-extension.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "winreg": "^1.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@pwa-debug/extension": "workspace:*",
    "@pwa-debug/shared": "workspace:*",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^20.17.6",
    "@types/winreg": "^1.2.36",
    "rollup": "^4.27.4",
    "tslib": "^2.8.1"
  }
}
