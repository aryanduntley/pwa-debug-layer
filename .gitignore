# Dependencies
node_modules/

# Build outputs
build/
dist/
packages/*/dist/
packages/host/extension/
*.tsbuildinfo

# EXCEPTION — the Claude Code plugin (.claude-plugin/plugin.json) runs
# packages/host/dist/main.js and loads the bundled extension from
# packages/host/extension/, so both are committed to work from a fresh clone.
# (Source maps stay ignored to keep the committed bundle lean.)
!packages/host/dist/
!packages/host/dist/**
!packages/host/extension/
!packages/host/extension/**
# ...but keep build-noise out of the committed bundle:
packages/host/dist/*.map
packages/host/dist/*.tsbuildinfo
packages/host/extension/*.map

# Test / coverage
coverage/
vitest.config.*.timestamp-*

# Environment (never commit secrets)
# Extension signing key — private RSA key for the pinned manifest "key" (stable
# extension ID). Only needed to pack a .crx; the public key lives in manifest.json.
.keys/
.env
.env.local
.env.production
secrets.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local MCP server registration — machine-specific (e.g. chrome-devtools-mcp's
# --browserUrl debug port). Each user/machine pins their own; not shared.
.mcp.json

# Local state databases (AIMFP project + user prefs, runtime state)
*.db
*.db-journal

# AIMFP blueprint snapshot backups (redundant with git history of the blueprint itself)
.aimfp-project/backups/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Reference material cloned for review, not part of this project
chrome-devtools-mcp-main/

# Misc
.cache/
tmp/
temp/

# Closed-source extensions kept locally for architectural reference (not for code copying)
reference/

# Local scratch / working notes — never committed
docs/